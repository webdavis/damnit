{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/pull.schema.json",
  "title": "dam pull answer",
  "description": "What dam pull prints with -o, one row per remote.",
  "type": "object",
  "required": [
    "remotes"
  ],
  "additionalProperties": false,
  "properties": {
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "remote",
          "created",
          "updated",
          "unchanged",
          "conflicts",
          "removed_upstream",
          "creates_matched",
          "values_kept",
          "deletes_confirmed"
        ],
        "additionalProperties": false,
        "properties": {
          "remote": {
            "type": "string"
          },
          "created": {
            "type": "integer",
            "minimum": 0
          },
          "updated": {
            "type": "integer",
            "minimum": 0
          },
          "unchanged": {
            "type": "integer",
            "minimum": 0
          },
          "conflicts": {
            "type": "integer",
            "minimum": 0
          },
          "removed_upstream": {
            "type": "integer",
            "minimum": 0
          },
          "creates_matched": {
            "type": "integer",
            "minimum": 0
          },
          "values_kept": {
            "type": "integer",
            "minimum": 0
          },
          "deletes_confirmed": {
            "type": "integer",
            "minimum": 0
          },
          "unseen_pulled": {
            "description": "Present and true only for a token, when the pull changed or kept an object it cannot read. Every count leaves those out, and task_pulled is left out for a token.",
            "const": true
          },
          "task_pulled": {
            "description": "What hook.task_pulled did on this pull. Absent when no such hook is set or the pull brought it no task.",
            "type": "object",
            "required": [
              "ran",
              "changed",
              "failed",
              "not_reached"
            ],
            "additionalProperties": false,
            "properties": {
              "ran": {
                "type": "integer",
                "minimum": 0
              },
              "changed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "not_reached": {
                "description": "Tasks the hook was not called for once the pull's 60 seconds for it ran out.",
                "type": "integer",
                "minimum": 0
              },
              "commit": {
                "description": "The commit holding the hook's changes, when changes is committed and a change was made.",
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    }
  }
}
