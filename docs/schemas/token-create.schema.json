{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/token-create.schema.json",
  "title": "dam token create answer",
  "description": "What dam token create prints on standard output with --json or --toon. value is the token itself and appears nowhere else.",
  "type": "object",
  "required": ["name", "key_id", "value", "expires", "via", "require", "grants", "warnings"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "key_id": { "type": "string", "pattern": "^[0-9A-Za-z]{12}$" },
    "value": { "type": "string", "pattern": "^damk_v1_[0-9A-Za-z]{12}_[0-9A-Za-z]{38}$" },
    "expires": { "type": ["string", "null"], "format": "date-time" },
    "via": { "type": "array", "items": { "enum": ["local", "mcp"] } },
    "require": { "type": "array", "items": { "type": "string" } },
    "grants": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/grant" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "required": ["allow", "paths", "labels", "own", "remotes"],
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+:[a-z]+$" } },
        "paths": { "type": ["array", "null"], "items": { "type": "string" } },
        "labels": { "type": ["array", "null"], "items": { "type": "string" } },
        "own": { "type": "boolean" },
        "remotes": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    }
  }
}
