{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/category-create.schema.json",
  "title": "dam category create answer",
  "description": "What dam category create prints with --json or --toon: the category it wrote to config.lua.",
  "type": "object",
  "required": ["name", "values", "exclusive"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exclusive": { "type": "boolean" }
  }
}
