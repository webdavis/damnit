{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/agenda.schema.json",
  "title": "dam agenda answer",
  "description": "What dam agenda prints with -o: the events in the window, earliest first, and with --kind task or any the tasks not done whose due falls on a day of the window, by day. An all-day event has dates for start and end.",
  "type": "object",
  "required": [
    "from",
    "to",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "from": {
      "$ref": "object.schema.json#/$defs/day",
      "description": "The first day of the window, in the person's zone."
    },
    "to": {
      "$ref": "object.schema.json#/$defs/day",
      "description": "The last day of the window, in the person's zone."
    },
    "tasks": {
      "description": "Present when --kind task or any, or a task field, asks for tasks; in the order dam list gives within each day.",
      "type": "array",
      "items": {
        "$ref": "object.schema.json",
        "required": [
          "day",
          "weekday"
        ],
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "oid",
          "subject",
          "path",
          "labels",
          "status",
          "transparency",
          "all_day",
          "start",
          "end",
          "busy",
          "attendees",
          "category",
          "day",
          "weekday"
        ],
        "additionalProperties": false,
        "properties": {
          "oid": {
            "$ref": "object.schema.json#/$defs/oid"
          },
          "subject": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "tentative",
              "cancelled"
            ]
          },
          "transparency": {
            "enum": [
              "busy",
              "free"
            ]
          },
          "all_day": {
            "type": "boolean"
          },
          "start": {
            "$ref": "object.schema.json#/$defs/when"
          },
          "end": {
            "$ref": "object.schema.json#/$defs/when"
          },
          "busy": {
            "type": "boolean",
            "description": "Whether the event holds the time."
          },
          "location": {
            "$ref": "object.schema.json#/$defs/event/properties/location"
          },
          "attendees": {
            "$ref": "object.schema.json#/$defs/event/properties/attendees"
          },
          "organizer": {
            "$ref": "object.schema.json#/$defs/event/properties/organizer"
          },
          "conference": {
            "$ref": "object.schema.json#/$defs/event/properties/conference"
          },
          "category": {
            "$ref": "object.schema.json#/$defs/category"
          },
          "day": {
            "$ref": "object.schema.json#/$defs/day",
            "description": "The day of its start in the person's zone; an event over several days is listed once, under this day."
          },
          "weekday": {
            "$ref": "object.schema.json#/$defs/weekday"
          }
        }
      }
    }
  }
}
