{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/hook-list.schema.json",
  "title": "dam hook list answer",
  "description": "What dam hook list prints with -o: each .lua file in the hooks folder beside config.lua, then inside a project each in its .damhooks folder, marked project, in the order task_new, task_changed, task_done, task_pulled, then files named for no event. hook is the event the file is named for, or null. A hook that loads carries on_failure, or changes for task_pulled, each the value dam uses, written or by default. A hook that does not load carries error, why. A project's hook file while project hooks are off carries off and is never loaded.",
  "type": "object",
  "required": [
    "hooks"
  ],
  "additionalProperties": false,
  "properties": {
    "hooks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "hook",
              "file",
              "loads",
              "on_failure"
            ],
            "additionalProperties": false,
            "properties": {
              "hook": {
                "enum": [
                  "task_new",
                  "task_changed",
                  "task_done"
                ]
              },
              "file": {
                "type": "string"
              },
              "loads": {
                "const": true
              },
              "on_failure": {
                "enum": [
                  "warn",
                  "refuse"
                ]
              },
              "project": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "hook",
              "file",
              "loads",
              "changes"
            ],
            "additionalProperties": false,
            "properties": {
              "hook": {
                "const": "task_pulled"
              },
              "file": {
                "type": "string"
              },
              "loads": {
                "const": true
              },
              "changes": {
                "enum": [
                  "committed",
                  "working"
                ]
              },
              "project": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "hook",
              "file",
              "loads",
              "error"
            ],
            "additionalProperties": false,
            "properties": {
              "hook": {
                "enum": [
                  "task_new",
                  "task_changed",
                  "task_done",
                  "task_pulled",
                  null
                ]
              },
              "file": {
                "type": "string"
              },
              "loads": {
                "const": false
              },
              "error": {
                "type": "string"
              },
              "project": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "hook",
              "file",
              "project",
              "off"
            ],
            "additionalProperties": false,
            "properties": {
              "hook": {
                "enum": [
                  "task_new",
                  "task_changed",
                  "task_done",
                  "task_pulled",
                  null
                ]
              },
              "file": {
                "type": "string"
              },
              "project": {
                "const": true
              },
              "off": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "hook",
              "file",
              "project",
              "changed"
            ],
            "additionalProperties": false,
            "properties": {
              "hook": {
                "enum": [
                  "task_new",
                  "task_changed",
                  "task_done",
                  "task_pulled",
                  null
                ]
              },
              "file": {
                "type": "string"
              },
              "project": {
                "const": true
              },
              "changed": {
                "enum": [
                  "changed",
                  "new",
                  "removed",
                  "unchanged"
                ],
                "description": "How this file differs from the files as they were when this clone turned its hooks on; the hooks did not run."
              }
            }
          }
        ]
      }
    },
    "unshown_files": {
      "type": "integer",
      "minimum": 1,
      "description": "Inside a project, how many .lua files in .damhooks are symbolic links or have a name holding a control character or not valid UTF-8; dam never loads or shows them. Left out when there are none."
    }
  }
}
