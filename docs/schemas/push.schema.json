{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/push.schema.json",
  "title": "dam push answer",
  "description": "What dam push prints with --json or --toon, one row per remote.",
  "type": "object",
  "required": [
    "remotes"
  ],
  "additionalProperties": false,
  "properties": {
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "remote",
          "sent",
          "succeeded",
          "skipped",
          "held",
          "failed"
        ],
        "additionalProperties": false,
        "properties": {
          "remote": {
            "type": "string"
          },
          "sent": {
            "type": "integer",
            "minimum": 0,
            "description": "For a token, counts only the objects it may read."
          },
          "succeeded": {
            "type": "integer",
            "minimum": 0,
            "description": "For a token, counts only the objects it may read."
          },
          "skipped": {
            "type": "integer",
            "minimum": 0,
            "description": "For a token, counts only the objects it may read."
          },
          "held": {
            "description": "Objects not sent because they, or an object they wait on, are in conflict. Null for a token without conflict:read when some were held.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "failed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "oid",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "oid": {
                  "$ref": "object.schema.json#/$defs/oid"
                },
                "why": {
                  "type": "string"
                }
              }
            },
            "description": "For a token, only the objects it may read."
          },
          "unseen_failed": {
            "description": "Present and true only for a token, when a change it cannot read failed or was held. It names nothing and counts nothing; the owner sees each in dam status.",
            "const": true
          }
        }
      }
    }
  }
}
