{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/remote-list.schema.json",
  "title": "dam remote list answer",
  "description": "What dam remote list prints with --json or --toon. A null holds no value: no path, no staleness bound, or never pulled or pushed.",
  "type": "object",
  "required": [
    "remotes"
  ],
  "additionalProperties": false,
  "properties": {
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "helper",
          "url",
          "path",
          "stale_seconds",
          "last_pull",
          "last_push"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "helper": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "stale_seconds": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "last_pull": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "last_push": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        }
      }
    }
  }
}
