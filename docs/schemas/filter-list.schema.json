{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/filter-list.schema.json",
  "title": "dam filter list answer",
  "description": "What dam filter list prints with -o. kind is function when the filter runs a match function, and query is present only when the filter has query text.",
  "type": "object",
  "required": [
    "filters"
  ],
  "additionalProperties": false,
  "properties": {
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "query",
              "function"
            ]
          },
          "query": {
            "type": "string"
          },
          "project": {
            "const": true,
            "description": "Present when the filter comes from the .dam.lua of the project dam runs in."
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "query"
            }
          }
        },
        "then": {
          "required": [
            "query"
          ]
        }
      }
    }
  }
}
