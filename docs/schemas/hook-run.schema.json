{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/hook-run.schema.json",
  "title": "dam hook run answer",
  "description": "What dam hook run prints with --json or --toon. ran counts the tasks the hook was called for, changed those whose change it left as a working change, failed those whose change it dropped, and not_reached the listed tasks it was not called for: after 60 seconds, or for task_pulled a task tracked on no remote. error is the first failure, naming the hook's file and line, or null. changed_by_hook lists each task the hook changed, and is left out when it changed none.",
  "type": "object",
  "required": [
    "hook",
    "ran",
    "changed",
    "failed",
    "not_reached",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "hook": {
      "enum": [
        "task_new",
        "task_changed",
        "task_done",
        "task_pulled"
      ]
    },
    "ran": {
      "type": "integer",
      "minimum": 0
    },
    "changed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "not_reached": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "file",
            "line",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "changed_by_hook": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "oid",
          "hook"
        ],
        "additionalProperties": false,
        "properties": {
          "oid": {
            "type": "string"
          },
          "hook": {
            "enum": [
              "task_new",
              "task_changed",
              "task_done",
              "task_pulled"
            ]
          }
        }
      }
    }
  }
}
