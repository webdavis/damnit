{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/status.schema.json",
  "title": "dam status document",
  "description": "What dam status prints with -o. A token sees staged with stage:read, unstaged with working:read, its own waiting items, and other senders' waiting items with pending:read.",
  "type": "object",
  "required": ["staged", "unstaged", "waiting", "sets", "conflicts", "notices", "unpushed", "warnings"],
  "additionalProperties": false,
  "properties": {
    "staged": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "unstaged": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "waiting": { "type": "array", "items": { "$ref": "#/$defs/waiting" } },
    "sets": { "type": "array", "items": { "$ref": "#/$defs/set" } },
    "conflicts": { "type": "array", "items": { "type": "object" } },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "missing_upstream" } } },
            "then": {
              "required": ["remote", "tasks"],
              "properties": {
                "remote": { "type": "string" },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["oid", "subject"],
                    "properties": { "oid": { "$ref": "#/$defs/id" }, "subject": { "type": "string" } }
                  }
                }
              }
            }
          },
          {
            "description": "A create that got no answer, of an object since removed here or no longer sent to that remote. The remote may hold a copy dam has no id for.",
            "if": { "properties": { "kind": { "const": "unanswered_create_dropped" } } },
            "then": {
              "required": ["remote", "oid", "subject", "path", "because"],
              "properties": {
                "remote": { "type": "string" },
                "oid": { "$ref": "#/$defs/id" },
                "subject": { "type": "string" },
                "path": { "type": "string" },
                "because": { "enum": ["removed", "no_longer_sent"] }
              }
            }
          },
          {
            "description": "The last run of hook.task_pulled on a pull from this remote failed on tasks or did not reach them. A later run replaces it, and a run that fails on none and reaches every task clears it. Never shown to a token.",
            "if": { "properties": { "kind": { "const": "task_pulled_failed" } } },
            "then": {
              "required": ["remote", "failed", "not_reached", "error"],
              "properties": {
                "remote": { "type": "string" },
                "failed": { "type": "integer", "minimum": 0 },
                "not_reached": { "type": "integer", "minimum": 0 },
                "error": {
                  "description": "The first error of that run, null when the run failed on no task.",
                  "type": ["object", "null"],
                  "required": ["file", "line", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "file": { "type": "string" },
                    "line": { "type": ["integer", "null"] },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "unpushed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["remote", "commits", "commit_ids", "oids"],
        "additionalProperties": false,
        "properties": {
          "remote": { "type": "string" },
          "commits": { "type": "integer", "minimum": 0 },
          "commit_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "oids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "unseen_failed": {
      "description": "Present and true only for a token, when a conflict, failed push or unpushed change it cannot read is there. It names nothing and counts nothing.",
      "const": true
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "change": {
      "description": "One change. from, key_id and channel name the token that made it, and are null for the owner. author is the token's name, or the owner's from the config. details are null for a change not yet staged, one recorded before dam kept them, and another sender's change read with a token.",
      "type": "object",
      "required": ["oid", "op", "fields", "kind", "subject", "path", "labels", "from", "key_id", "channel", "author", "details"],
      "properties": {
        "oid": { "$ref": "#/$defs/id" },
        "op": { "enum": ["create", "update", "delete"] },
        "fields": { "type": "array", "items": { "type": "string" } },
        "kind": { "enum": ["task", "event"] },
        "subject": { "type": "string" },
        "path": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "done": { "type": "boolean" },
        "completed_at": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
        "priority": { "type": "integer" },
        "due": { "anyOf": [{ "type": "null" }, { "$ref": "object.schema.json#/$defs/when" }] },
        "start": { "$ref": "object.schema.json#/$defs/when" },
        "end": { "$ref": "object.schema.json#/$defs/when" },
        "before": { "anyOf": [{ "type": "null" }, { "$ref": "object.schema.json" }] },
        "after": { "anyOf": [{ "type": "null" }, { "$ref": "object.schema.json" }] },
        "from": { "type": ["string", "null"] },
        "key_id": { "type": ["string", "null"], "pattern": "^[0-9A-Za-z]{12}$" },
        "channel": { "enum": ["local", "mcp", null] },
        "author": { "type": "string" },
        "details": { "anyOf": [{ "type": "null" }, { "$ref": "object.schema.json#/$defs/details" }] }
      }
    },
    "set": {
      "description": "Items a token sent with --as-one, waiting as one set: dam add <set> takes them all or none and dam rm <set> declines them all. A token sees a set it sent or one whose every item it may see.",
      "type": "object",
      "required": ["set", "from", "count", "created", "age", "items"],
      "additionalProperties": false,
      "properties": {
        "set": { "$ref": "#/$defs/id" },
        "from": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "created": { "type": "string", "format": "date-time" },
        "age": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/waiting" } }
      }
    },
    "waiting": {
      "description": "An item a token sent, waiting for the owner. oid is the object it makes or changes; dam add <hash> takes it and dam rm <hash> declines it. age is whole seconds since created. removes is on a removal item, for the owner only: what adding it changes, as dam rm says.",
      "allOf": [{ "$ref": "#/$defs/change" }],
      "required": ["hash", "item", "created", "age"],
      "properties": {
        "hash": { "$ref": "#/$defs/id" },
        "item": { "enum": ["new", "change", "removal"] },
        "from": { "type": "string" },
        "key_id": { "type": "string" },
        "channel": { "enum": ["local", "mcp"] },
        "created": { "type": "string", "format": "date-time" },
        "age": { "type": "integer", "minimum": 0 },
        "removes": {
          "type": "object",
          "required": ["descendants", "dependents", "attached"],
          "additionalProperties": false,
          "properties": {
            "descendants": { "$ref": "object.schema.json#/$defs/oids" },
            "dependents": { "$ref": "object.schema.json#/$defs/oids" },
            "attached": { "$ref": "object.schema.json#/$defs/oids" }
          }
        }
      }
    }
  }
}
