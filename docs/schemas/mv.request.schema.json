{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webdavis/damnit/docs/schemas/mv.request.schema.json",
  "title": "dam mv request",
  "description": "The arguments dam mv takes.",
  "type": "object",
  "required": [
    "oid"
  ],
  "anyOf": [
    {
      "required": [
        "path"
      ]
    },
    {
      "required": [
        "parent"
      ]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{4,40}$",
      "description": "An oid, or a prefix of 4 or more hex characters."
    },
    "path": {
      "type": "string",
      "description": "A path such as work/clients/."
    },
    "parent": {
      "type": "string",
      "pattern": "^[0-9a-f]{4,40}$",
      "description": "Put it in the object with this oid or prefix."
    },
    "meta": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "The request's details, as --meta KEY=VALUE passes them: harness, session, model, effort, version or any other key."
    }
  }
}
